<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".AnadirPrestamoFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">
        <!-- TODO : Me falta poner en el 'strings.xml' lo de los warnings -->
        <TextView
            android:id="@+id/tvLabelSelectorLibro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccionar Libro"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Spinner
            android:id="@+id/spinnerLibros"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_border"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelSelectorLibro" />

        <TextView
            android:id="@+id/tvLabelSelectorUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Asignar al Usuario"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerLibros" />

        <Spinner
            android:id="@+id/spinnerUsuarios"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_border"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelSelectorUsuario" />

        <TextView
            android:id="@+id/tvLabelFechaInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Fecha de Inicio"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerUsuarios" />

        <EditText
            android:id="@+id/etFechaInicio"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_border"
            android:focusable="false"
            android:hint="Seleccionar fecha"
            android:inputType="none"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelFechaInicio" />

        <TextView
            android:id="@+id/tvLabelFechaFin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Fecha de Devolución"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etFechaInicio" />

        <EditText
            android:id="@+id/etFechaFin"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_border"
            android:focusable="false"
            android:hint="Seleccionar fecha"
            android:inputType="none"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelFechaFin" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarPrestamo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="16dp"
            android:text="Cancelar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#94D1BE"
            app:cornerRadius="28dp"
            app:layout_constraintEnd_toStartOf="@id/btnGuardarPrestamo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etFechaFin" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarPrestamo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Guardar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#008566"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toBottomOf="@id/btnCancelarPrestamo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnCancelarPrestamo"
            app:layout_constraintTop_toTopOf="@id/btnCancelarPrestamo" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>